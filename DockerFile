# 1. Base Image: GUMAMIT NG OFFICIAL MAVEN IMAGE DITO
# Ang image na ito ay may JDK 17 at Maven pre-installed.
FROM maven:3.8.7-jdk-17 AS build

# 2. Copy source code
WORKDIR /app
COPY . /app

# 3. Build the application (Skipping tests for faster deployment)
# Dito na magwo-work ang 'mvn' command
RUN mvn clean install -DskipTests

# 4. Final Stage: Gumamit ng mas maliit na Java Runtime Environment (JRE)
FROM eclipse-temurin:17-jre-alpine

# 5. Copy the built JAR file from the build stage (Gamitin ang eksaktong pangalan mo)
COPY --from=build /app/target/registrar-portal-0.0.1-SNAPSHOT.jar app.jar

# 6. Set the entry point to run the JAR
ENTRYPOINT ["java", "-jar", "/app.jar"]